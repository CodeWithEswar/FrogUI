{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frogui.dev/schema/registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "description",
    "categories",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "description"
        ],
        "properties": {
          "id": {
            "enum": [
              "actions",
              "inputs",
              "data-display",
              "feedback",
              "navigation",
              "overlays",
              "layout"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "file": {
            "type": "string",
            "pattern": "^components/[a-z0-9-]+\\.json$"
          }
        }
      }
    }
  }
}
