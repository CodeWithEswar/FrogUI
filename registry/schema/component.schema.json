{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frogui.dev/schema/component.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "displayName",
    "description",
    "category",
    "status",
    "since",
    "docs",
    "source",
    "showcase",
    "variants",
    "sizes",
    "tags",
    "properties",
    "examples"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "pattern": "^Frog[A-Z][a-zA-Z0-9]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "actions",
        "inputs",
        "data-display",
        "feedback",
        "navigation",
        "overlays",
        "layout"
      ]
    },
    "status": {
      "enum": [
        "experimental",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "since": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "docs": {
      "type": "string",
      "pattern": "^/components/[a-z0-9-]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^frogui-components/src/main/.*\\.kt$"
    },
    "showcase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "source",
        "screen"
      ],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^components/[a-z0-9-]+$"
        },
        "source": {
          "type": "string",
          "pattern": "^app/src/main/.*\\.kt$"
        },
        "screen": {
          "type": "string",
          "description": "Kotlin showcase screen or composable definition factory function.",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        }
      }
    },
    "variants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sizes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "minTouchTarget"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "minTouchTarget": {
          "type": "string",
          "minLength": 1
        },
        "talkBackNotes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "defaultValue",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "defaultValue": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "https://frogui.dev/schema/example.schema.json"
      }
    },
    "stabilityReview": {
      "type": "string",
      "pattern": "^docs/components/[a-z0-9-]+-review\\.md$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stable"
          }
        }
      },
      "then": {
        "required": [
          "stabilityReview",
          "accessibility"
        ],
        "properties": {
          "stabilityReview": {},
          "accessibility": {},
          "properties": {
            "type": "array",
            "minItems": 1
          },
          "examples": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
